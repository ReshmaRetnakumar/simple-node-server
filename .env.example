# Leave a section empty/unset and that API simply returns 503. The app still starts.

PORT=3000

# SQL (Postgres)
PG_HOST=15.207.111.104
PG_PORT=5432
PG_USER=myapp_user
PG_PASSWORD=12345
PG_DATABASE=myapp

# NoSQL (DynamoDB) - table needs a partition key, e.g. "id" (String)
DYNAMODB_TABLE=
AWS_REGION=ap-south-1
# Only for DynamoDB Local, e.g. http://localhost:8000
DYNAMODB_ENDPOINT=
